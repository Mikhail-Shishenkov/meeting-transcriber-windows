<Window x:Class="PolinMegatranscriber.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PolinMegatranscriber.App"
        Title="{DynamicResource AppTitle}"
        Width="760" Height="820"
        MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/Megatranscriber-AppIcon.png"
        Foreground="{DynamicResource TextBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Loaded="Window_Loaded">
    <Window.Resources>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="13" />
        </Style>
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Padding="12,10"
                                CornerRadius="12"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="Check"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="{DynamicResource ForestBrush}"
                                        Visibility="Collapsed">
                                    <TextBlock Text="✓" Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ForestBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ForestBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ForestBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ActionBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource ActionBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ForestBrush}" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="22" HorizontalAlignment="Center" MaxWidth="680">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource BrandTitle}"
                                   FontFamily="Georgia"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ForestBrush}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{DynamicResource Subtitle}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <ComboBox x:Name="LanguageSelector" Width="108" Height="30"
                                  Margin="0,0,8,0" Style="{StaticResource ThemeComboBox}"
                                  SelectionChanged="Language_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource LanguageRussian}" Tag="Russian" />
                            <ComboBoxItem Content="{DynamicResource LanguageEnglish}" Tag="English" />
                            <ComboBoxItem Content="{DynamicResource LanguageItalian}" Tag="Italian" />
                        </ComboBox>
                        <ComboBox x:Name="AppearanceSelector" Width="108" Height="30"
                                  Style="{StaticResource ThemeComboBox}"
                                  SelectedIndex="0"
                                  SelectionChanged="Appearance_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource ThemeSystem}" Tag="System" />
                            <ComboBoxItem Content="{DynamicResource ThemeLight}" Tag="Light" />
                            <ComboBoxItem Content="{DynamicResource ThemeDark}" Tag="Dark" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}">
                    <Border MinHeight="170" Margin="0,0,0,14"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="18">
                        <Grid>
                            <Rectangle Margin="1.5" RadiusX="18" RadiusY="18"
                                       Stroke="{DynamicResource BorderBrush}"
                                       StrokeThickness="1.2"
                                       StrokeDashArray="7 5" />
                            <StackPanel Margin="18,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="31" Foreground="{DynamicResource TerracottaBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="590"
                                           Foreground="{DynamicResource TextBrush}" />
                                <Grid Margin="0,5,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding FileDetails}" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Center"
                                               Visibility="{Binding HasInputFile, Converter={StaticResource InverseBoolToVisibility}}" />

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <StackPanel.Visibility>
                                            <Binding Path="HasInputFile" Converter="{StaticResource BoolToVisibility}" />
                                        </StackPanel.Visibility>
                                        <Border Background="{DynamicResource SelectedBrush}"
                                                CornerRadius="6"
                                                Padding="7,2"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding FileBadge}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForestBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding FileDetails}"
                                                   Style="{StaticResource Muted}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Button Content="{Binding FileButtonText}"
                                        Margin="0,10,0,0"
                                        Padding="20,8"
                                        MinWidth="132"
                                        HorizontalAlignment="Center"
                                        IsEnabled="{Binding InputsEnabled}"
                                        Click="ChooseFile_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionMode}" Style="{StaticResource SectionTitle}" />
                            <UniformGrid Columns="3" Margin="-3" IsEnabled="{Binding InputsEnabled}">
                                <RadioButton GroupName="Mode" Style="{StaticResource ChoiceCard}"
                                             IsChecked="{Binding IsAudioOnly, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ModeAudioOnly}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="MP3" Margin="0,6,0,0" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Mode" Style="{StaticResource ChoiceCard}"
                                             IsChecked="{Binding IsTextOnly, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ModeTextOnly}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="TXT + SRT" Margin="0,6,0,0" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Mode" Style="{StaticResource ChoiceCard}"
                                             IsChecked="{Binding IsAudioAndText, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ModeAudioText}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="MP3 + TXT + SRT" Margin="0,6,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"
                            Visibility="{Binding ShowsModelSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionModel}" Style="{StaticResource SectionTitle}" />
                            <UniformGrid Columns="2" Margin="-3" IsEnabled="{Binding InputsEnabled}">
                            <RadioButton GroupName="Model" Style="{StaticResource ChoiceCard}"
                                         IsChecked="{Binding IsSmall, Mode=TwoWay}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Faster}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{DynamicResource Recommended}" Margin="8,1,0,0" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource ForestBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource ModelSmallDetail}" Margin="0,6,0,0" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding SmallStatus}" Margin="0,4,0,0" FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Model" Style="{StaticResource ChoiceCard}"
                                         IsChecked="{Binding IsMedium, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource MoreAccurate}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{DynamicResource ModelMediumDetail}" Margin="0,6,0,0" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding MediumStatus}" Margin="0,4,0,0" FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"
                            Visibility="{Binding ShowsModelSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionRecordingLanguage}" Style="{StaticResource SectionTitle}" />
                            <UniformGrid Columns="3" Margin="-3" IsEnabled="{Binding InputsEnabled}">
                                <RadioButton GroupName="RecordingLanguage" Style="{StaticResource ChoiceCard}"
                                             MinHeight="72" IsChecked="{Binding IsRecordingRussian, Mode=TwoWay}">
                                    <TextBlock Text="{DynamicResource LanguageRussian}" FontWeight="SemiBold" FontSize="14" />
                                </RadioButton>
                                <RadioButton GroupName="RecordingLanguage" Style="{StaticResource ChoiceCard}"
                                             MinHeight="72" IsChecked="{Binding IsRecordingEnglish, Mode=TwoWay}">
                                    <TextBlock Text="{DynamicResource LanguageEnglish}" FontWeight="SemiBold" FontSize="14" />
                                </RadioButton>
                                <RadioButton GroupName="RecordingLanguage" Style="{StaticResource ChoiceCard}"
                                             MinHeight="72" IsChecked="{Binding IsRecordingItalian, Mode=TwoWay}">
                                    <TextBlock Text="{DynamicResource LanguageItalian}" FontWeight="SemiBold" FontSize="14" />
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionOutput}" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                           Foreground="{DynamicResource MustardBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="11,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputDirectory}"
                                           Foreground="{DynamicResource TextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource NextToSource}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInputFile}" Value="True">
                                                    <Setter Property="Text" Value="{Binding OutputDirectory}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="2" Content="{DynamicResource Change}" Click="ChooseFolder_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInputFile}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"
                        Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CurrentJob}" FontWeight="SemiBold" Foreground="{DynamicResource ForestBrush}" />
                        <TextBlock Text="{Binding FileName}" Margin="0,8,0,0" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedModeTitle}" Margin="0,4,0,0" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding OutputDirectory}" Margin="0,4,0,0" Style="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"
                        Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding StageText}" FontWeight="SemiBold" Margin="0,0,55,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForestBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Height="9" Margin="0,12,0,0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{DynamicResource ForestBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource MustardBrush}"
                        Visibility="{Binding ShowCancelled, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CancelledTitle}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,5,0,0" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource TerracottaBrush}"
                        Visibility="{Binding ShowFailure, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource FailureTitle}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TerracottaBrush}" />
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14"
                        Background="{DynamicResource SelectedBrush}"
                        BorderBrush="{DynamicResource ForestBrush}"
                        Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24"
                                    CornerRadius="12"
                                    Background="{DynamicResource ForestBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✓"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource Done}"
                                       Margin="9,0,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForestBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding OutputFileNames}" Margin="0,8,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=✓  {0}}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0"
                                    Margin="0,0,5,8"
                                    MinHeight="42"
                                    Content="{DynamicResource RevealResult}"
                                    Click="RevealResult_Click" />

                            <Button Grid.Row="0" Grid.Column="1"
                                    Margin="5,0,0,8"
                                    MinHeight="42"
                                    Content="{DynamicResource OpenResultsFolder}"
                                    Click="OpenResultsFolder_Click" />

                            <Button Grid.Row="1" Grid.Column="0"
                                    Margin="0,0,5,0"
                                    MinHeight="42"
                                    Content="{DynamicResource OpenText}"
                                    Click="OpenText_Click"
                                    Visibility="{Binding HasTextOutput, Converter={StaticResource BoolToVisibility}}" />

                            <Button Grid.Row="1" Grid.Column="1"
                                    Margin="5,0,0,0"
                                    MinHeight="42"
                                    Content="{Binding CopyTextLabel}"
                                    Click="CopyText_Click"
                                    Visibility="{Binding HasTextOutput, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="{DynamicResource StartProcessing}" Style="{StaticResource ActionButton}"
                        IsEnabled="{Binding CanStart}" Click="Start_Click"
                        Margin="0,0,0,10"
                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding CancelButtonText}" Style="{StaticResource ActionButton}"
                        Click="Cancel_Click" Margin="0,0,0,10"
                        Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{DynamicResource ProcessAnother}"
                        Style="{StaticResource ActionButton}"
                        Click="AnotherFile_Click"
                        Margin="0,0,0,10"
                        Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal" Margin="2,6,0,10" HorizontalAlignment="Left">
                    <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource ForestBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Privacy}"
                               Margin="7,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
