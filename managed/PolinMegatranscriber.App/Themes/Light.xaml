<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#FFF3E7D8</Color>
    <Color x:Key="SurfaceColor">#FFFDF6EC</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFFFF</Color>
    <Color x:Key="ForestColor">#FF1F4933</Color>
    <Color x:Key="TerracottaColor">#FF9E452B</Color>
    <Color x:Key="MustardColor">#FFBF851E</Color>
    <Color x:Key="ActionColor">#FF9E452B</Color>
    <Color x:Key="TextColor">#FF26322B</Color>
    <Color x:Key="MutedTextColor">#FF6D746F</Color>
    <Color x:Key="BorderColor">#2F1F4933</Color>
    <Color x:Key="SelectedColor">#241F4933</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ForestBrush" Color="{StaticResource ForestColor}" />
    <SolidColorBrush x:Key="TerracottaBrush" Color="{StaticResource TerracottaColor}" />
    <SolidColorBrush x:Key="MustardBrush" Color="{StaticResource MustardColor}" />
    <SolidColorBrush x:Key="ActionBrush" Color="{StaticResource ActionColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
</ResourceDictionary>
